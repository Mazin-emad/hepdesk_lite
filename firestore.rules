rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getCurrentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRequester() {
      return isAuthenticated() && resource.data.requesterId == request.auth.uid;
    }

    function isStaffOrManager() {
      return hasUserDoc()
        && (
          getCurrentUserData().role == 'staff'
          || getCurrentUserData().role == 'manager'
        );
    }

    function isManager() {
      return hasUserDoc() && getCurrentUserData().role == 'manager';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isCommentAppendByCaller() {
      return changedKeys().hasOnly(['comments', 'updatedAt'])
        && request.resource.data.comments is list
        && resource.data.comments is list
        && request.resource.data.comments.size() == resource.data.comments.size() + 1
        && request.resource.data.comments[request.resource.data.comments.size() - 1].authorId == request.auth.uid;
    }

    function isPublicCommentAppendByRequester() {
      return isCommentAppendByCaller()
        && !(request.resource.data.comments[request.resource.data.comments.size() - 1].isInternal == true);
    }

    function isStatusOrAssignmentUpdate() {
      return changedKeys().hasOnly(['status', 'updatedAt', 'stateHistory', 'ownerId', 'ownerName'])
        && request.resource.data.stateHistory is list
        && resource.data.stateHistory is list
        && request.resource.data.stateHistory.size() == resource.data.stateHistory.size() + 1;
    }

    function isRequesterResolvedTransition() {
      return changedKeys().hasOnly(['status', 'updatedAt', 'stateHistory'])
        && resource.data.status == 'Resolved'
        && request.resource.data.status in ['Closed', 'In Progress']
        && request.resource.data.stateHistory is list
        && resource.data.stateHistory is list
        && request.resource.data.stateHistory.size() == resource.data.stateHistory.size() + 1;
    }

    function isSelfProfileUpdate(userId) {
      return request.auth.uid == userId
        && changedKeys().hasOnly(['name', 'email', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isManagerProfileUpdate() {
      return changedKeys().hasOnly(['role', 'name', 'email', 'disabled', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId || isStaffOrManager());
      allow create: if false;
      allow update: if isAuthenticated()
        && (
          isSelfProfileUpdate(userId)
          || (isManager() && isManagerProfileUpdate())
        );
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid || isStaffOrManager()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'New' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.ownerId == null &&
        request.resource.data.ownerName == null;

      allow update: if isAuthenticated() && (
        (
          isStaffOrManager()
          && (isStatusOrAssignmentUpdate() || isCommentAppendByCaller())
        )
        || (
          isRequester()
          && (isRequesterResolvedTransition() || isPublicCommentAppendByRequester())
        )
      );

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && changedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create: if isStaffOrManager()
        && request.resource.data.userId is string
        && request.resource.data.ticketId is string
        && request.resource.data.ticketTitle is string
        && request.resource.data.type is string
        && request.resource.data.message is string
        && request.resource.data.read == false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
