rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role checkers
    function isEmployee() {
      return isAuthenticated() && getUserData().role == 'employee';
    }
    
    function isStaff() {
      return isAuthenticated() && (getUserData().role == 'staff' || getUserData().role == 'manager');
    }
    
    function isManager() {
      return isAuthenticated() && getUserData().role == 'manager';
    }
    
    // Users collection
    match /users/{userId} {
      // User can read and edit own record, manager can read all user records for workload
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManager() || isStaff());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isManager());
      allow delete: if isManager();
    }
    
    // Tickets collection
    match /tickets/{ticketId} {
      // Employee can read only their own tickets, staff and manager can read all tickets
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid || isStaff() || isManager()
      );
      
      // Any authenticated user can create a ticket with status 'New' and themselves as requester
      allow create: if isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'New' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 2000;
        
      // Staff and Manager can update tickets (state transitions, assignment, etc.)
      // Employees can only update if it's their own ticket and only to add comments/reopen
      allow update: if isAuthenticated() && (
        isStaff() || isManager() ||
        (resource.data.requesterId == request.auth.uid)
      );
      
      allow delete: if isManager();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read and update (mark read) their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // System/Authenticated users can create notifications
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
